# PostgreSQL connection settings.
# Copy this file to database.env and replace DB_PASSWORD before running locally.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ostory_db
DB_USER=ostory_user
DB_PASSWORD=<FILL_ME_DB_PASSWORD>
# Local-only development commonly uses disable. Remote production must use
# verify-full unless an operator has completed and documented a network review.
DB_SSLMODE=disable

# Optional pool settings.
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=50
DB_MAX_QUERIES=50000
DB_MAX_IDLE_TIME=300
